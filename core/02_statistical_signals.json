  "patterns": [
    {
      "id": "STAT-001",
      "name": "Low Perplexity",
      "formula": "PPL = exp(-1/N sum log P)",
      "threshold": "<40 AI vs >60 human",
      "method": "GPT-2/Neo-2.7B",
      "confidence": 0.92,
      "sources": [
        "arxiv:1906.04043",
        "arxiv:2401.12070"
      ],
      "estimated_half_life_months": 24
    },
    {
      "id": "STAT-002",
      "name": "Low Burstiness",
      "formula": "std(PPL_sentence)/mean",
      "threshold": "Var <20",
      "confidence": 0.88,
